<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UwpXrayDepotPaths">
    <UwpXrayDepotBase Condition="'$(UwpXrayDepotBase)'==''">$(SolutionDir)extern\uwp-xray-depot</UwpXrayDepotBase>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(UwpXrayDepotBase)\x64\include;$(UwpXrayDepotBase)\src\xb-xray;$(UwpXrayDepotBase)\external\spdlog\include;$(UwpXrayDepotBase)\external\json\single_include;$(UwpXrayDepotBase)\external\lua;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>XB_INSPECTOR_ENABLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(UwpXrayDepotBase)\x64\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>lua5.4.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
